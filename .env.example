# Supabase (Settings > API Keys in the dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only secret key. Needed to send push notifications.
# NEVER put NEXT_PUBLIC_ in front of this one.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Push notifications. Create the pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
